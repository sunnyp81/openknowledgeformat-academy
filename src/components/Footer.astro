---
import { NAV, OFFICIAL, SITE_NAME_SHORT } from '../consts';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-paper-2/60">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 font-semibold text-ink">
          <span
            class="grid h-7 w-7 place-items-center rounded-md bg-accent text-white font-mono text-xs"
            aria-hidden="true">{'{ }'}</span>
          {SITE_NAME_SHORT}
        </div>
        <p class="mt-3 max-w-sm text-sm text-muted">
          An independent learning resource for the Open Knowledge Format. Not
          affiliated with, sponsored by, or endorsed by Google.
        </p>
      </div>

      <nav aria-label="Footer">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Learn</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {NAV.slice(0, 5).map((item) => (
            <li><a class="text-ink-soft hover:text-accent" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Official</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-ink-soft hover:text-accent" href={OFFICIAL.blog} rel="noopener nofollow" target="_blank">Google Cloud announcement<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a class="text-ink-soft hover:text-accent" href={OFFICIAL.repo} rel="noopener nofollow" target="_blank">Spec repository<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a class="text-ink-soft hover:text-accent" href="/resources/">All resources</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-6 text-xs text-muted">
      <p>&copy; {year} {SITE_NAME_SHORT}. Educational content provided as-is. "Open Knowledge Format" and "Google Cloud" are referenced for descriptive purposes only.</p>
    </div>
  </div>
</footer>
