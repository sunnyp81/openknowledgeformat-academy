---
import BaseLayout from './BaseLayout.astro';
import { SITE_ORIGIN, SITE_TITLE, CRUMB_LABELS } from '../consts';

const { frontmatter } = Astro.props;
const {
  title,
  h1,
  description,
  pubDate = '2026-06-26',
  modDate,
  faq = [],
} = frontmatter;

const path = Astro.url.pathname;
const url = new URL(path, SITE_ORIGIN).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1 ?? title,
  description,
  inLanguage: 'en',
  datePublished: pubDate,
  dateModified: modDate ?? pubDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@id': `${SITE_ORIGIN}/#organization` },
  publisher: { '@id': `${SITE_ORIGIN}/#organization` },
  isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
};

const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const schemas = [articleSchema, ...(faqSchema ? [faqSchema] : [])];

// Visible breadcrumb trail.
const segments = path.split('/').filter(Boolean);
const crumbs = segments.map((seg, i) => ({
  label: CRUMB_LABELS[seg] ?? seg,
  href: `/${segments.slice(0, i + 1).join('/')}/`,
  last: i === segments.length - 1,
}));
---
<BaseLayout title={title} description={description} ogType="article" schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-8">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-accent">Home</a></li>
        {crumbs.map((c) => (
          <li class="flex items-center gap-1">
            <span aria-hidden="true" class="text-line">/</span>
            {c.last
              ? <span aria-current="page" class="text-ink-soft">{c.label}</span>
              : <a href={c.href} class="hover:text-accent">{c.label}</a>}
          </li>
        ))}
      </ol>
    </nav>

    <header class="mb-8 border-b border-line pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink text-balance">{h1 ?? title}</h1>
      {description && <p class="mt-4 text-lg text-ink-soft">{description}</p>}
      <p class="mt-4 text-xs text-muted">Last updated {pubDate}. Independent resource, not affiliated with Google.</p>
    </header>

    <article class="prose prose-lg pb-12">
      <slot />
    </article>

    {faq.length > 0 && (
      <section class="mb-16" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-2xl font-bold text-ink mb-6">Frequently asked questions</h2>
        <div class="divide-y divide-line rounded-xl border border-line bg-white/40">
          {faq.map((f: { q: string; a: string }) => (
            <details class="group p-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-ink list-none">
                <span>{f.q}</span>
                <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-ink-soft">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
